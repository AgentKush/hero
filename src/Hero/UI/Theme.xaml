<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        HERO design tokens.

        Dark-first. Surfaces are layered rather than bordered: elevation is expressed by
        lightness, not by drawing a line around everything.

        Sizing note: this machine's primary display is 4096x2160 at 125% DPI. WPF works in
        device-independent pixels, so DPI is handled by the OS, but a 4K panel still makes a
        12px body physically small. The type scale below is therefore set one step larger than
        a typical 1080p desktop app, and MainWindow applies an additional responsive
        ScaleTransform tied to window width.
    -->

    <!-- ============ Surfaces ============ -->
    <Color x:Key="Surface0Color">#0E1116</Color>
    <Color x:Key="Surface1Color">#151A21</Color>
    <Color x:Key="Surface2Color">#1C232C</Color>
    <Color x:Key="Surface3Color">#242D38</Color>
    <SolidColorBrush x:Key="Surface0" Color="{StaticResource Surface0Color}" />
    <SolidColorBrush x:Key="Surface1" Color="{StaticResource Surface1Color}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />

    <!-- ============ Text ============ -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#EDF1F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#A6B2C2" />
    <SolidColorBrush x:Key="TextTertiary"  Color="#78849A" />

    <!-- ============ Lines ============ -->
    <SolidColorBrush x:Key="Divider"  Color="#232B36" />
    <SolidColorBrush x:Key="HairLine" Color="#2E3945" />

    <!-- ============ Accent ============ -->
    <SolidColorBrush x:Key="Accent"      Color="#4C8DFF" />
    <SolidColorBrush x:Key="AccentMuted" Color="#2A4A80" />

    <!-- Semantic severity. Calm, not alarmist: a security tool that screams red is ignored. -->
    <SolidColorBrush x:Key="SevSafe"     Color="#3FB984" />
    <SolidColorBrush x:Key="SevLow"      Color="#7E93AC" />
    <SolidColorBrush x:Key="SevMedium"   Color="#E0A54B" />
    <SolidColorBrush x:Key="SevHigh"     Color="#E8743B" />
    <SolidColorBrush x:Key="SevCritical" Color="#E5484D" />

    <!-- ============ Typography ============
         Both faces ship with Windows 11, so nothing is downloaded. -->
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="UIFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <!-- Modular type scale (ratio ~1.22), one step up from a 1080p-targeted app. -->
    <sys:Double x:Key="FsDisplay">34</sys:Double>
    <sys:Double x:Key="FsTitle">22</sys:Double>
    <sys:Double x:Key="FsSection">17</sys:Double>
    <sys:Double x:Key="FsBodyLarge">15.5</sys:Double>
    <sys:Double x:Key="FsBody">14.5</sys:Double>
    <sys:Double x:Key="FsMono">13.5</sys:Double>
    <sys:Double x:Key="FsCaption">12.5</sys:Double>
    <sys:Double x:Key="FsMicro">11.5</sys:Double>
    <sys:Double x:Key="FsStatValue">38</sys:Double>

    <!-- ============ Scrollbars ============
         The WPF default is a light-grey Windows-XP-era control with stepper arrows; against a
         dark surface it reads as a foreign object stapled to the window. This replaces it with
         an overlay thumb that widens on hover and has no stepper buttons at all. -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar"
                            Background="#3D4857"
                            CornerRadius="4"
                            Margin="3,2,3,2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#566579" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="#6B7C93" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stepper buttons are removed by templating them to nothing; leaving them out of the
         template entirely breaks ScrollBar's expected part names. -->
    <Style x:Key="ScrollNoButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollNoButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollNoButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollNoButton}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollNoButton}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ScrollViewer: no border, and the vertical bar overlays the content instead of
         stealing a 12px column that shifts the layout when it appears. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid>
                        <!-- The PART_ name is mandatory: ScrollViewer locates its content
                             presenter by name to drive scroll offsets. Omitting it leaves the
                             viewer unable to control its own position, which shows up as the
                             view starting part-way down the content. -->
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                Margin="{TemplateBinding Padding}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar"
                                   HorizontalAlignment="Right"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}"
                                   Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar"
                                   VerticalAlignment="Bottom"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}"
                                   Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Cards ============ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="#99151A21" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="24,20,24,22" />
        <Setter Property="Margin" Value="0,0,0,18" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#1F2833" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FsSection}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- ============ Caption buttons ============
         Hand-built because WPF's default Button chrome is unmistakably dated. Glyphs come
         from Segoe Fluent Icons, which ships with Windows 11. -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="46" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#22FFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#11FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E5484D" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
